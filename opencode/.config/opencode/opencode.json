{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/engram",
          "mcp",
          "--tools=agent"
        ]
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "Superset": {
        "type": "remote",
        "url": "https://superset-mcp.marker.builders/mcp"
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "redirect_uri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    },
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/compat/opencode-go/v1"
      }
    },
    "coeus": {
      "name": "Coeus",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://llm.box.jspmarc.dev"
      },
      "models": {
        "qwen-3.8-27b": {
          "name": "Coeus: Qwen 3.8 27B",
          "limit": {
            "context": 98304,
            "output": 65536
          }
        },
        "qwen-3.5-9b": {
          "name": "Coeus: Qwen 3.5 9B",
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "gemma-4-26b-a4b": {
          "name": "Coeus: Gemma 4 26B A4B",
          "limit": {
            "context": 98304,
            "output": 65536
          }
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "openrouter",
      "effect": "deny"
    }
  ],
  "plugins": [
    "./plugins/caveman"
  ]
}
