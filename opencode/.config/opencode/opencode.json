{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/engram",
          "mcp",
          "--tools=agent"
        ]
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "Superset": {
        "type": "remote",
        "url": "https://superset-mcp.marker.builders/mcp"
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "redirect_uri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "providers": {
    "coeus": {
      "name": "Coeus",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://llm.box.jspmarc.dev"
      },
      "models": {
        "qwen-3.8-27b": {
          "name": "Coeus: Qwen 3.8 27B",
          "limit": {
            "context": 131072
          }
        },
        "qwen-3.5-9b": {
          "name": "Coeus: Qwen 3.5 9B",
          "limit": {
            "context": 262144
          }
        },
        "gemma-4-26b-a4b": {
          "name": "Coeus: Gemma 4 26B A4B",
          "limit": {
            "context": 131072
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "anthropic/claude-opus-5.5": {
          "name": "opus-5.5"
        },
        "anthropic/claude-sonnet-5.5": {
          "name": "sonnet-5.5"
        },
        "google/gemini-4-argon": {
          "name": "gemini-4-argon"
        },
        "moonshotai/kimi-k3.1-pro": {
          "name": "kimi-k3.1-pro"
        },
        "z-ai/glm-5.3": {
          "name": "glm-5.3"
        }
      }
    }
  },
  "plugins": [
    "./plugins/caveman"
  ],
  "agents": {
    "explore": { "model": "neuralwatt/qwen3.6-35b" }
  }
}
