{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "numbers"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true
  },
  "debug": {
    "devtools": true,
    "turn_tokens": false,
    "timing": false
  },
  "experimental": {
    "client-mcp": false,
    "new-designs": true
  }
}
